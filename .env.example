# Copy to .env. Credentials stay on the server and are never committed.
# Uses the Gemini Developer API. Free-tier eligibility depends on your Google project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# Choose sarvam or gemini. No automatic provider fallback.
TRANSCRIPTION_PROVIDER=sarvam
PORT=4317
